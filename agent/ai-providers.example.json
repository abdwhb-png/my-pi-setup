{
    "providers": {
        "cpa": true
    },
    "cpa": {
        "metadataRules": [
            {
                "match": {
                    "id": "example-model-*",
                    "ownedBy": "example-owner"
                },
                "metadata": {
                    "contextWindow": 128000,
                    "maxTokens": 16384,
                    "reasoning": true,
                    "input": ["text", "image"],
                    "cost": {
                        "input": 1,
                        "output": 2,
                        "cacheRead": 0.1,
                        "cacheWrite": 0
                    }
                }
            },
            {
                "match": { "id": "example-model-exact" },
                "metadata": { "contextWindow": 256000 }
            }
        ]
    }
}
