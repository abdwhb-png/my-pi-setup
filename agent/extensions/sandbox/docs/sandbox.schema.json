{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Sandbox configuration v2",
  "description": "Editor schema for the two active sandbox.json locations. The runtime additionally validates machine identity, ownership, canonical paths, resource ceilings and semantic rules.",
  "oneOf": [
    {
      "$ref": "#/$defs/globalConfig"
    },
    {
      "$ref": "#/$defs/projectConfig"
    }
  ],
  "$defs": {
    "globalConfig": {
      "title": "Global ~/.pi/agent/sandbox.json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "machineId"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 2
        },
        "machineId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "sandbox",
            "host"
          ],
          "deprecated": true,
          "description": "Legacy host authorization alias. Use host.allowed; an explicit host.allowed takes precedence."
        },
        "tmpNamespace": {
          "enum": [
            "lease-private",
            "host"
          ]
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedHostDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowLocalBinding": {
              "type": "boolean"
            },
            "mediatedDirectTcp": {
              "$ref": "#/$defs/globalMediatedDirectTcp"
            }
          }
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowRead": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowWrite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyRead": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyReadWhenExternal": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyWrite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyWriteWhenExternal": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedVariables": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedVariables": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "variables": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "installations": {
              "$ref": "#/$defs/globalInstallations"
            }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "type": "boolean",
              "default": false
            },
            "mode": {
              "enum": [
                "targeted",
                "full"
              ],
              "default": "targeted"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^unix:///"
            },
            "operations": {
              "$ref": "#/$defs/dockerOperations"
            },
            "unsafeTargets": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/dockerSelector"
              }
            },
            "breakGlassMaxMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 30,
              "description": "Ceiling for /sandbox docker break-glass. Global only; a project document cannot set it."
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "full"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "operations"
                  ]
                }
              }
            }
          ]
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed"
          ],
          "properties": {
            "allowed": {
              "type": "boolean",
              "default": false
            }
          },
          "description": "Authorize explicit host mode selection for a session. Never selects host mode automatically."
        }
      }
    },
    "projectConfig": {
      "title": "Project .pi/sandbox.json",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "sandbox"
        },
        "tmpNamespace": {
          "enum": [
            "lease-private",
            "host"
          ]
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedHostDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowLocalBinding": {
              "type": "boolean"
            },
            "mediatedDirectTcp": {
              "$ref": "#/$defs/projectMediatedDirectTcp"
            }
          }
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowRead": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowWrite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyRead": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyWrite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedVariables": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedVariables": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "variables": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "installations": {
              "$ref": "#/$defs/projectInstallations"
            }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "targets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/projectDockerTarget"
              }
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "dockerSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "container-name"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "project",
            "service"
          ],
          "properties": {
            "type": {
              "const": "compose-service"
            },
            "project": {
              "type": "string",
              "minLength": 1
            },
            "service": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "projectDockerTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/dockerSelector"
        },
        "operations": {
          "$ref": "#/$defs/dockerOperations"
        }
      }
    },
    "mediatedDirectTcpPorts": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "globalMediatedDirectTcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "ports"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "ports": {
          "$ref": "#/$defs/mediatedDirectTcpPorts"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allowed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "ports": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "ports": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "projectMediatedDirectTcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ports"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ports": {
          "$ref": "#/$defs/mediatedDirectTcpPorts"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "ports": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "ports": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unixSockets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tcpPublications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tcpPublication"
          }
        }
      }
    },
    "globalInstallations": {
      "description": "Machine authority map. Runtime validation requires canonical, existing directory roots and rejects roots that cover the private runtime.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/globalInstallationRoot"
        }
      }
    },
    "globalInstallationRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/|~/)[^\\u0000*?\\[\\]{}:]*$",
          "description": "Canonical directory used as a base for relative paths. Grants the whole directory only when files is absent."
        },
        "path": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000*?\\[\\]{}:]+$"
          },
          "description": "Command directories relative to root. Changes command lookup only. With files, adding a command directory does not grant read access to that directory."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000*?\\[\\]{}:]+$"
          },
          "description": "Optional exact regular files relative to root. When present, grants only these files, not their parent directory or siblings. Symlink targets must also be explicitly covered by a selected installation. Empty lists are rejected."
        }
      }
    },
    "projectInstallations": {
      "description": "Selection of names declared by the global environment.installations map. A project cannot declare roots or reorder global PATH precedence.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tcpPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "scope",
        "listen",
        "target"
      ],
      "properties": {
        "transport": {
          "const": "tcp"
        },
        "scope": {
          "enum": [
            "host",
            "lan"
          ]
        },
        "listen": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dockerOperations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ps",
          "inspect",
          "logs",
          "stats",
          "exec",
          "start",
          "stop",
          "restart"
        ]
      }
    }
  }
}
