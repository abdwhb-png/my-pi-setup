{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Sandbox global Docker authority",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grants"],
      "properties": {
        "grants": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["projectRoot", "mode"],
                "properties": {
                  "projectRoot": { "type": "string", "minLength": 1 },
                  "mode": { "const": "full" },
                  "endpoint": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["projectRoot", "mode", "targets"],
                "properties": {
                  "projectRoot": { "type": "string", "minLength": 1 },
                  "mode": { "const": "targeted" },
                  "endpoint": { "type": "string", "minLength": 1 },
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["selector", "allowUnsafeTarget"],
                      "properties": {
                        "selector": {
                          "oneOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["type", "name"],
                              "properties": {
                                "type": { "const": "container-name" },
                                "name": { "type": "string", "minLength": 1 }
                              }
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["type", "project", "service"],
                              "properties": {
                                "type": { "const": "compose-service" },
                                "project": { "type": "string", "minLength": 1 },
                                "service": { "type": "string", "minLength": 1 }
                              }
                            }
                          ]
                        },
                        "operations": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "enum": ["ps", "inspect", "logs", "stats", "exec", "start", "stop", "restart"]
                          }
                        },
                        "allowUnsafeTarget": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
