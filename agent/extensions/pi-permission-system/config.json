{
    "authorizerChain": [
        "pi-dangerous-mode"
    ],
    "yoloMode": false,
    "shellTools": {
        "safe_bash": {
            "commandArgument": "command"
        }
    },
    "permission": {
        "*": "allow",
        "path": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow",
            "agent/roles/*": "ask"
        },
        "bash": {
            "rm *": "ask",
            "sudo *": "ask",
            "docker *": "ask",
            "docker info *": "allow",
            "docker ps *": "allow",
            "docker logs *": "allow",
            "docker inspect *": "allow",
            "git *": "ask",
            "git remote -v": "allow",
            "git * remote -v": "allow",
            "git status *": "allow",
            "git * status *": "allow",
            "git log *": "allow",
            "git * log *": "allow",
            "git show *": "allow",
            "git * show *": "allow",
            "git diff *": "allow",
            "git * diff *": "allow",
            "git stash list": "allow",
            "git * stash list": "allow",
            "readlink *": "allow",
            "* */node_modules/*": "ask",
            "ls */node_modules/*": "allow",
            "grep */node_modules/*": "allow",
            "cat */node_modules/*": "allow",
            "find */node_modules/*": "allow",
            "./node_modules/.bin/oxfmt *": "allow",
            "* ./node_modules/.bin/oxfmt *": "allow",
            "./node_modules/.bin/oxlint *": "allow",
            "* ./node_modules/.bin/oxlint *": "allow"
        },
        "write": {
            "*": "allow",
            "node_modules/*": "deny",
            "*/.pi/agent/git/*": "deny",
            "*/.pi/agent/npm/*": "deny",
            "AGENTS.md": "ask",
            "*/.pi/agent/settings.json": "ask",
            "*/.pi/agent/sessions/*": "ask",
            "*/.pi/agent/pi-hermes-memory": "ask"
        },
        "edit": {
            "*": "allow",
            "node_modules/*": "deny",
            "*/.pi/agent/git/*": "deny",
            "*/.pi/agent/npm/*": "deny",
            "AGENTS.md": "ask",
            "*/.pi/agent/settings.json": "ask",
            "*/.pi/agent/sessions/*": "ask",
            "*/.pi/agent/pi-hermes-memory": "ask"
        },
        "external_directory": {
            "*": "ask",
            "/tmp/*": "allow",
            "/tmp/pi-*/*": "allow",
            "~/.pi/*": "allow",
            "~/.bun/install/global/node_modules/@earendil-works/*": "allow",
            "~/.agents/*": "allow",
            "~/projects/*": "allow"
        }
    }
}
