{
    "name": "agent",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "bun test --isolate",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --isolate --coverage",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint-staged": "oxfmt --no-error-on-unmatched-pattern",
        "lint": "oxlint .",
        "lint:check": "oxlint . --deny-warnings",
        "lint:fix": "oxlint . --fix",
        "typecheck": "tsc --noEmit",
        "types:check": "bun run typecheck",
        "check": "bun scripts/check.ts",
        "check:parse": "find extensions -name '*.ts' ! -name '*.test.ts' ! -path '*/node_modules/*' -print0 | xargs -0 -P4 -I{} bun build --no-bundle --no-clear-screen '{}' >/dev/null 2>&1 || exit 1"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "packageManager": "bun@1.3.14",
    "dependencies": {
        "@dietrichgebert/ponytail": "^4.8.4",
        "@earendil-works/pi-coding-agent": "^0.81.1",
        "@earendil-works/pi-tui": "^0.81.1",
        "@marcfargas/pi-test-harness": "^0.6.1",
        "@mendable/firecrawl-js": "^4.28.0",
        "@sinclair/typebox": "0.34.49",
        "oxlint-tsgolint": "^0.23.0",
        "pi-roles": "file:../../projects/pi-integrations/pi-roles",
        "typebox": "^1.2.14"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "^25.9.3",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.70.0",
        "typescript": "^6.0.3",
        "typescript-7": "npm:typescript@rc"
    }
}
