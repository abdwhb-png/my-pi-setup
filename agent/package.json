    "lint:storage": "oxlint -c .oxlintrc.storage.json extensions",
    "lint": "bun run lint:boundaries && bun run lint:storage && oxlint .",
    "lint:check": "bun run lint:boundaries && bun run lint:storage && oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "types:check": "bun run typecheck",
    "check": "bun scripts/check.ts",
    "check:parse": "find extensions -name '*.ts' ! -name '*.test.ts' ! -path '*/node_modules/*' -print0 | xargs -0 -P4 -I{} bun build --no-bundle --no-clear-screen '{}' >/dev/null 2>&1 || exit 1",
    "check:pi-runtime": "bun scripts/check-pi-runtime-coherence.ts"
  },
