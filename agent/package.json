  "scripts": {
    "test": "bun test --isolate",
    "test:configuration-audit": "PI_CONFIGURATION_AUDIT=1 bun test --isolate extensions/tool-groups/migration.test.ts extensions/pi-roles/features/planning-configuration.audit.test.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --isolate --coverage",
    "test:sandbox:zerobox-candidate": "bash scripts/run-zerobox-candidate-contracts.sh",
    "fmt": "oxfmt extensions/**/*.ts",
    "fmt:check": "oxfmt --check extensions/**/*.ts",
    "fmt:files": "oxfmt",
    "fmt:files:check": "oxfmt --check",
    "lint-staged": "oxfmt --no-error-on-unmatched-pattern",
    "lint:boundaries": "bun tooling/extension-boundaries/check.mjs extensions && oxlint -c .oxlintrc.boundaries.json extensions",
    "lint:storage": "oxlint -c .oxlintrc.storage.json extensions",
    "lint": "bun run lint:boundaries && bun run lint:storage && oxlint .",
    "lint:check": "bun run lint:boundaries && bun run lint:storage && oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "types:check": "bun run typecheck",
    "check": "bun scripts/check.ts",
    "check:parse": "find extensions -name '*.ts' ! -name '*.test.ts' ! -path '*/node_modules/*' -print0 | xargs -0 -P4 -I{} bun build --no-bundle --no-clear-screen '{}' >/dev/null 2>&1 || exit 1",
    "check:pi-runtime": "bun scripts/check-pi-runtime-coherence.ts"
  },
