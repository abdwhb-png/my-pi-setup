{
    "compilerOptions": {
        "types": ["bun", "node"],
        "target": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "noImplicitAny": true,
        "paths": {
            "bun:test": ["./node_modules/bun-types/test.d.ts"],
            "pi-fancy-footer": [
                "../../projects/pi-integrations/pi-fancy-footer/src/index.ts"
            ],
            "pi-fancy-footer/api": [
                "../../projects/pi-integrations/pi-fancy-footer/src/api.ts"
            ]
        }
    },
    "include": [
        "extensions/**/*.ts",
        "bin/**/*.ts",
        "scripts/check-pi-runtime-coherence.ts",
        "../.pi/extensions/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "git",
        "npm",
        "npm/node_modules/pi-subagents",
        "npm/node_modules/pi-fancy-footer",
        "skills",
        "extensions-legacy",
        "extensions/herdr-agent-state.ts"
    ]
}
