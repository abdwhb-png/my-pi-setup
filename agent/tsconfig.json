{
    "compilerOptions": {
        "types": ["bun", "node"],
        "target": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "noImplicitAny": true,
        "paths": {
            "bun:test": ["./node_modules/bun-types/test.d.ts"],
            "@earendil-works/pi-agent-core": [
                "./node_modules/@earendil-works/pi-agent-core/dist/index"
            ],
            "@earendil-works/pi-ai": [
                "./node_modules/@earendil-works/pi-coding-agent/dist/core/extensions/pi-ai-extension-view",
                "./node_modules/@earendil-works/pi-ai/dist/index"
            ],
            "@earendil-works/pi-ai/*": [
                "./node_modules/@earendil-works/pi-ai/dist/*"
            ],
            "@earendil-works/pi-coding-agent": [
                "./node_modules/@earendil-works/pi-coding-agent/dist/index"
            ],
            "@earendil-works/pi-tui": [
                "./node_modules/@earendil-works/pi-tui/dist/index"
            ],
            "#src/*": [
                "./npm/node_modules/@gotgenes/pi-permission-system/src/*.ts"
            ],
            "pi-fancy-footer": [
                "../../engineering/pi-integrations/pi-fancy-footer/src/index.ts"
            ],
            "pi-fancy-footer/api": [
                "../../engineering/pi-integrations/pi-fancy-footer/src/api.ts"
            ]
        }
    },
    "include": [
        "extensions/**/*.ts",
        "bin/**/*.ts",
        "scripts/check-pi-runtime-coherence.ts",
        "../.pi/extensions/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "git",
        "npm",
        "npm/node_modules/pi-subagents",
        "npm/node_modules/pi-fancy-footer",
        "skills",
        "extensions-legacy",
        "extensions/herdr-agent-state.ts"
    ]
}
