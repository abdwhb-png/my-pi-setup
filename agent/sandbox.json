{
    "enabled": true,
    "filesystem": {
        "denyRead": ["~/.ssh", "~/.gnupg"],
        "allowWrite": ["."],
        "denyWrite": [
            ".env",
            ".env.*",
            "*.pem",
            "*.key"
        ]
    },
    "network": {
        "allowedDomains": [
            "github.com",
            "*.github.com",
            "localhost:8317",
            "localhost:8320"
        ],
        "deniedDomains": []
    }
}
