{
    "defaultProvider": "cpa",
    "defaultModel": "deepseek/deepseek-v4-flash",
    "defaultThinkingLevel": "medium",
    "hideThinkingBlock": false,
    "theme": "dark",
    "steeringMode": "all",
    "followUpMode": "all",
    "npmCommand": ["bun"],
    "extensions": [
        "~/.pi/agent/extensions/package-finalizer.ts",
        "~/engineering/shared-services/pi-lens-dist/index.js",
        "~/.pi/agent/extensions/pi-overrides/index.ts"
    ],
    "packages": [
        "npm:pi-subagents",
        "npm:pi-web-access",
        "npm:@juicesharp/rpiv-ask-user-question",
        "npm:pi-mcp-adapter",
        "npm:@juicesharp/rpiv-todo",
        "npm:pi-hermes-memory",
        "~/engineering/pi-integrations/pi-fancy-footer",
        "npm:@gotgenes/pi-permission-system",
        "npm:@ogulcancelik/pi-herdr",
        "./extensions/tool-groups"
    ],
    "subagents": {
        "defaultModel": "cpa/ocg/go-deepseek-v4-flash",
        "turnBudget": {
            "maxTurns": 40,
            "graceTurns": 10
        },
        "agentOverrides": {
            "worker": {
                "model": "cpa/ocg/go-deepseek-v4-flash",
                "thinking": "high",
                "tools": [
                    "@inspect",
                    "@lens-write",
                    "@implement",
                    "contact_supervisor"
                ],
                "subagentOnlyExtensions": [
                    "~/.pi/agent/extensions/save-tokens/subagent-profiles/ultra.ts"
                ]
            },
            "scout": {
                "model": "cpa/ocg/mimo-v2.5",
                "thinking": "high",
                "tools": ["@inspect", "@lens", "safe_bash", "write"]
            },
            "researcher": {
                "model": "cpa/ocg/go-deepseek-v4-pro"
            },
            "reviewer": {
                "model": "zai/glm-5.2"
            },
            "planner": {
                "model": "cpa/ocg/go-deepseek-v4-pro",
                "tools": ["@inspect", "@lens", "write_plan"]
            },
            "oracle": {
                "model": "zai/glm-5.2",
                "thinking": "xhigh"
            },
            "delegate": {
                "tools": [
                    "@inspect",
                    "@lens-write",
                    "@implement",
                    "contact_supervisor"
                ]
            },
            "context-builder": {
                "model": "cpa/ocg/mimo-v2.5",
                "tools": ["@inspect", "@lens", "safe_bash", "write", "@web"]
            },
            "plan-reviewer": {
                "model": "openai-codex/gpt-5.6-luna"
            },
            "sdd-orchestrator": {},
            "oh-my-oracle": {},
            "quick-worker": {
                "model": "cpa/ocg/go-deepseek-v4-flash",
                "subagentOnlyExtensions": [
                    "~/.pi/agent/extensions/save-tokens/subagent-profiles/ultra.ts"
                ]
            },
            "sdd-worker": {
                "model": "cpa/ocg/go-deepseek-v4-flash"
            }
        }
    }
}
