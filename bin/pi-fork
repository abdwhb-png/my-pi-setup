#!/usr/bin/env bun
import { resolve } from "node:path";
import {
  createPiForkCliDependencies,
  runPiForkCli,
} from "../agent/bin/pi-fork-cli.ts";
import { resolvePiInstallationPaths } from "../agent/bin/pi-installation-paths.ts";

const paths = resolvePiInstallationPaths(resolve(import.meta.dir, ".."));
const dependencies = createPiForkCliDependencies(paths);

process.exit(await runPiForkCli(process.argv.slice(2), dependencies));
