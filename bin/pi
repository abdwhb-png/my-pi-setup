#!/usr/bin/env bun
import { fileURLToPath } from "node:url";
import {
  classifyUpdateCommand,
  isPackageMutationCommand,
  isToolGroupsPackageConfigured,
  prepareToolGroupArgs,
  resolveRealPiPath,
  runPackageFinalizer,
  runRealPi,
} from "../agent/bin/pi-wrapper-lib.ts";

const args = process.argv.slice(2);
const cwd = process.cwd();
const updatePolicy = classifyUpdateCommand(args);
if (!updatePolicy.allowed) {
  console.error(updatePolicy.reason);
  process.exit(2);
}

let realPi: string;
try {
  realPi = resolveRealPiPath();
} catch (cause) {
  const message = cause instanceof Error ? cause.message : String(cause);
  console.error(`${message}\nRun: pi-fork deploy`);
  process.exit(1);
}

if (!process.env.PI_SUBAGENT_PI_BINARY?.trim()) {
  process.env.PI_SUBAGENT_PI_BINARY = fileURLToPath(import.meta.url);
}

if (process.env.PI_PACKAGE_FINALIZER_ACTIVE !== "1") {
  await runPackageFinalizer(cwd, { force: false, quiet: true });
}

const prepared = prepareToolGroupArgs(args, isToolGroupsPackageConfigured(cwd));
const exitCode = runRealPi(realPi, prepared.args, cwd, prepared.requestedTools);

if (exitCode === 0 && process.env.PI_PACKAGE_FINALIZER_ACTIVE !== "1" && isPackageMutationCommand(args)) {
  await runPackageFinalizer(cwd, { force: true, quiet: false });
}

process.exit(exitCode);
