{
    "servers": [
        {
            "id": "typescript",
            "extensions": [
                ".ts",
                ".js"
            ],
            "languageIds": [
                "typescript",
                "javascript"
            ],
            "command": "typescript-language-server",
            "args": [
                "--stdio"
            ],
            "rootPatterns": [
                "agent/tsconfig.json",
                "agent/package.json"
            ]
        }
    ],
    "requestTimeout": 30000,
    "autoStart": true,
    "logLevel": "info",
    "idleTimeout": 1800000
}